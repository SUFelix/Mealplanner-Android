<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup / transfer rules for Android 12 (API 31) and above.
   Everything is included by default; we only exclude the auth SharedPreferences
   (JWT token, username, role) from both cloud backup and device-to-device transfer.
   Meal plan, shopping list, recipes and images (all local-only) are still carried over.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
