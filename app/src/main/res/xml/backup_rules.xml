<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 (API 30) and below.
   Everything is backed up by default; we only exclude the auth SharedPreferences
   (JWT token, username, role) so credentials never leave the device in a backup.
   Meal plan, shopping list, recipes and images (all local-only) still get backed up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="prefs.xml"/>
</full-backup-content>
